# ForgeOS Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# REQUIRED — Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgeos_dev?schema=public"

# REQUIRED — Auth secret (auto-generated by setup.sh)
AUTH_SECRET=""

# OPTIONAL — Anthropic AI (for idea enrichment, task generation, spec generation)
ANTHROPIC_API_KEY=""

# OPTIONAL — GitHub App (for repo sync, PR tracking, webhooks)
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

