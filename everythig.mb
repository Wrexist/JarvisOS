3. DATABASE SCHEMA (MVP, CLEAN + SCALABLE)

Using PostgreSQL

USERS
users (
  id UUID PK,
  email TEXT UNIQUE,
  name TEXT,
  created_at TIMESTAMP
)
IDEAS
ideas (
  id UUID PK,
  user_id UUID FK,
  title TEXT,
  description TEXT,
  problem TEXT,
  target_user TEXT,
  status TEXT, -- inbox, validated, converted
  score INT,
  created_at TIMESTAMP
)
PROJECTS
projects (
  id UUID PK,
  user_id UUID FK,
  idea_id UUID FK,
  name TEXT,
  description TEXT,
  stage TEXT, -- planning, building, shipped
  repo_url TEXT,
  created_at TIMESTAMP
)
TASKS
tasks (
  id UUID PK,
  project_id UUID FK,
  title TEXT,
  description TEXT,
  status TEXT, -- todo, doing, done
  priority INT,
  ai_generated BOOLEAN,
  created_at TIMESTAMP
)
DOCUMENTS
documents (
  id UUID PK,
  project_id UUID FK,
  title TEXT,
  content TEXT,
  type TEXT, -- spec, notes
  created_at TIMESTAMP
)
GITHUB PRs
pull_requests (
  id UUID PK,
  project_id UUID FK,
  pr_number INT,
  title TEXT,
  status TEXT,
  url TEXT,
  created_at TIMESTAMP
)
AI PROMPTS LOG
ai_runs (
  id UUID PK,
  project_id UUID,
  task_id UUID,
  type TEXT, -- spec, tasks, code_prompt
  input TEXT,
  output TEXT,
  created_at TIMESTAMP
)
FUTURE READY (don’t build yet)
agents
metrics
blockers
assumptions
